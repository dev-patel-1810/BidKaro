# Local environment variables. Copy to .env and replace placeholders.
# Never commit real secrets.

APP_ENV=development
APP_NAME=BidKaro API
API_PREFIX=/api

# MongoDB
# Local default. For Atlas use the mongodb+srv:// URI shown under Atlas > Connect > Drivers,
# and percent-encode special characters in the password (for example @ -> %40).
# Atlas setup: database user with readWrite on this database, and your IP in Network Access.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=bidkaro
MONGODB_APP_NAME=BidKaro
MONGODB_MAX_POOL_SIZE=20
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000
MONGODB_RETRY_WRITES=true

# One-time local -> Atlas copy only (scripts/migrate-to-atlas.py). Not read by the API.
# The app itself always uses MONGODB_URI.
ATLAS_MONGODB_URI=

# Authentication
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gmail SMTP for signup verification and sign-in OTP.
# Create a Google App Password (Google Account > Security > 2-Step Verification >
# App passwords) and put it here. Never use or commit the normal Gmail password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=bidkaroindia@gmail.com
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=BidKaro
SMTP_TIMEOUT_SECONDS=20
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Frontend origin allowed by CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Local file storage
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# TinyFish (Phase 2). Required for live discovery.
# The API key is sent as the X-API-Key header; base URL defaults to https://agent.tinyfish.ai.
TINYFISH_API_KEY=
TINYFISH_BASE_URL=https://agent.tinyfish.ai
TINYFISH_AGENT_TIMEOUT_SECONDS=120

# Agentic TinyFish. The agent API runs a goal-driven browser agent; the browser
# API opens a remote session we drive over CDP (this is what lets a user
# answer a captcha and lets the agent continue in the same page).
TINYFISH_AGENT_BASE_URL=https://agent.tinyfish.ai
TINYFISH_BROWSER_BASE_URL=https://api.browser.tinyfish.ai

# Agentic scraping. The proxy exit country matters: Indian portals answer
# Indian traffic differently, so the default is India.
# A step or duration limit of 0 means "do not send one": not every TinyFish
# account is enabled for custom limits, and sending one is refused.
AGENT_MAX_STEPS=0
AGENT_MAX_DURATION_SECONDS=0
AGENT_MAX_WAIT_SECONDS=120
AGENT_POLL_INTERVAL_SECONDS=2
AGENT_BROWSER_TIMEOUT_SECONDS=900
AGENT_BROWSER_PAGE_TIMEOUT_MS=90000
AGENT_PROXY_COUNTRY_CODE=IN
# How far a portal walk goes.
AGENT_WALK_MAX_PAGES=5
AGENT_WALK_MAX_NOTICES=10
# One organisation may not take the whole notice budget: a department's list
# covers everything it does, not just the work the company does.
AGENT_WALK_MAX_NOTICES_PER_ORG=4
# The organisation directory is alphabetical and long, so an organisation late
# in the alphabet needs a bigger number of pages.
AGENT_WALK_MAX_ORG_PAGES=8
AGENT_WALK_MAX_ATTEMPTS=3
AGENT_CHALLENGE_WAIT_SECONDS=600

# Discovery tuning (Phase 2)
DISCOVERY_MAX_CANDIDATES=20
DISCOVERY_FETCH_LIMIT=12
DISCOVERY_MIN_SCORE=0.3
DISCOVERY_CACHE_HOURS=24
# Checkpointed Run Discovery: tenders are read in batches so the first batch
# is usable while the rest are still being read. The agent workflows then walk
# the portal one after the other.
DISCOVERY_BATCH_SIZE=5
DISCOVERY_MAX_TENDERS=25
DISCOVERY_AGENT_WAIT_SECONDS=1800
# The normal web-search stage. false means a run starts with the autonomous
# portal workflow instead: no search, no candidate pages read.
DISCOVERY_SEARCH_ENABLED=false
# true means a run shows only what it finds: the tenders from older runs leave
# the list (they are not dismissed or saved, so a later run can find them again).
# false means the whole stored list is always shown.
DISCOVERY_RESET_LIST_ON_RUN=false
# Empty means the built-in Central Public Procurement Portal directory.
DISCOVERY_PORTAL_URL=

# AI provider (Phase 3). Keep provider selection explicit.
AI_PROVIDER=groq
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2000

# PDF text extraction and user-triggered requirement extraction (Phase 3).
PDF_MAX_PAGES=200
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MAX_PAGES=40
OCR_TIMEOUT_SECONDS=45
# Optional explicit path, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
AI_EXTRACTION_MAX_CHUNK_CHARS=4000
AI_EXTRACTION_MAX_PAGES_PER_CHUNK=3
AI_EXTRACTION_MAX_CHUNKS=12
AI_EXTRACTION_MAX_PAGES=80
