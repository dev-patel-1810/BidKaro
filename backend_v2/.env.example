# Copy to .env and replace placeholders. Never commit real secrets.

APP_ENV=development
APP_NAME=BidKaro API
API_PREFIX=/api

# Postgres is the only required service.
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:55432/bidkaro_v2

# Authentication
JWT_SECRET=qwertyuioplkjhgfdsazxcvbnm123456
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Gmail SMTP for signup verification and sign-in codes.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=bidkaroindia@gmail.com
SMTP_APP_PASSWORD=your-google-app-password
SMTP_FROM_NAME=BidKaro
SMTP_TIMEOUT_SECONDS=20
OTP_EXPIRE_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_SENDS_PER_HOUR=5
OTP_MAX_ATTEMPTS=5

# Frontend origin allowed by CORS (comma-separated).
CORS_ORIGINS=*

# Local file storage (content-addressed by sha256).
STORAGE_DIR=./storage
MAX_UPLOAD_MB=25

# Discovery is installed in this tree. A deployment that removes the module
# sets this false; the frontend hides its affordances from GET /api/health.
FEATURES_DISCOVERY=true

# AI / PDF / OCR (stage D). Groq proposes; the citation gate decides.
# An empty key leaves the AI pass off; extraction reports 503 instead of guessing.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_TOKENS=2000

PDF_MAX_PAGES=200
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_DPI=300
OCR_MAX_PAGES=40
OCR_TIMEOUT_SECONDS=45
TESSERACT_CMD=

AI_EXTRACTION_MAX_CHUNK_CHARS=4000
AI_EXTRACTION_MAX_PAGES_PER_CHUNK=3
AI_EXTRACTION_MAX_CHUNKS=12
AI_EXTRACTION_MAX_PAGES=80

# Durable jobs and the single browser lane. Tests set these to false.
JOBS_ENABLED=true
JOB_WORKERS=2
JOB_POLL_SECONDS=0.5
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=60

# Refuse to start when the database is stamped behind the migration head.
# Every request against a stale schema fails with an undefined table; failing
# once at startup, with the alembic command in the message, is the fix.
SCHEMA_CHECK=true

# Scraping module only (registered by the module, not the base).
SCRAPE_INTERVAL_HOURS=24
AGENT_CHALLENGE_WAIT_SECONDS=600
DOC_FETCH_AUTO_ON=false
DOC_FETCH_MAX_PARALLEL=1

# Portal walk caps. These explain a 4-8 tender run on screen: they are caps,
# not failures. 0 for AGENT_WALK_MAX_NOTICES_PER_ORG means no per-org limit.
DISCOVERY_DIRECTORY_URL=https://etenders.gov.in/eprocure/app?page=FrontEndTendersByOrganisation&service=page
AGENT_WALK_MAX_PAGES=5
AGENT_WALK_MAX_NOTICES=10
AGENT_WALK_MAX_NOTICES_PER_ORG=4
AGENT_WALK_MAX_ORG_PAGES=4
DISCOVERY_MAX_TENDERS=25
# A real portal challenge is answered in this browser window, so a machine
# that must hand off to a human needs a desktop and BROWSER_HEADLESS=false.
BROWSER_HEADLESS=true
BROWSER_TIMEOUT_MS=60000
BROWSER_PROXY_SERVER=
